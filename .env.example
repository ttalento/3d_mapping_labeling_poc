# Copy to .env and fill in. .env is gitignored.
# Get a key at https://aistudio.google.com/apikey
#
# The key is read from the first of these that is set:
#   GEMINI_API_KEY, GOOGLE_API_KEY, API_KEY
GEMINI_API_KEY=

# Optional. Overrides the model in configs/*.yaml.
# Read from GEMINI_MODEL or MODEL. Routing prefixes are stripped, so
# "google/gemini-3.6-flash" and "gemini-3.6-flash" both work.
# Lite models are noticeably weaker at spatial grounding (boxes and masks).
# GEMINI_MODEL=gemini-3.6-flash

# NOTE: on Gemini's FREE tier, Google may use submitted content to improve their
# products. Fine for a test room; not fine for a client site or anything
# confidential. The paid tier changes this.
